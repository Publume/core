# OpenAI-compatible AI endpoint
AI_PROVIDER=openai-compatible
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=
AI_ALLOWED_MODELS=
AI_RESPONSE_FORMAT=json_object
AI_TIMEOUT_SECONDS=60

# Target site repository
TARGET_REPOSITORY=owner/site-repository
TARGET_REPO_TOKEN=
TARGET_BRANCH=main

# Content mission
SOURCE_URLS=
CONTENT_INSTRUCTIONS=
GATE_PROMPT=
ARTICLE_PROMPT=
OUTPUT_LANGUAGES=en
PUBLISH_THRESHOLD=0.75
DEDUPLICATION_CONTEXT_SIZE=50
MAX_ITEM_AGE_HOURS=24
MAX_CANDIDATES_PER_RUN=20
MAX_DECISION_RECORDS=1000
MAX_PENDING_DELIVERIES=500
MINIMUM_CONTENT_LENGTH=80
SOURCE_TIMEOUT_SECONDS=20
STATE_PATH=state/decisions.json

# Optional notification channels (store as a secret in CI)
DELIVERY_CONFIG=[]

# Theme source
THEME_REPOSITORY=Publume/themes
THEME_REF=main
THEME=editorial

# Site identity and presentation
SITE_URL=
SITE_NAME=Publume Site
SITE_DESCRIPTION="Independent reporting selected from verifiable sources."
SITE_TAGLINE="Signal over noise."
SITE_LOCALE=en
SITE_PUBLISHER_NAME=Publume Site
SITE_AUTHOR_NAME=Editorial Desk
SITE_CONTACT_URL=
SITE_AI_DISCLOSURE="Automation assists with selection and drafting. Every article retains its source links."
SITE_SOCIAL_IMAGE_URL=
SITE_NEWSLETTER_URL=
SITE_SPONSOR_URL=
SITE_THEME=default
SITE_PRIMARY_COLOR="#2563eb"
SITE_ACCENT_COLOR="#0891b2"
SITE_BACKGROUND_COLOR="#ffffff"
SITE_SURFACE_COLOR="#f8fafc"
SITE_TEXT_COLOR="#0f172a"
SITE_MUTED_COLOR="#64748b"
SITE_MAX_WIDTH=1180px
SITE_CARD_RADIUS=16px
SITE_ARTICLE_TITLE_MAX_SIZE=3rem
SITE_SHOW_TOPICS=true
SITE_SHOW_SCORE=false
SITE_SHOW_SOURCES=true
SITE_FOOTER_TEXT="Published with Publume."
