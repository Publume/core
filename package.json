{
  "name": "@publume/core",
  "version": "0.1.0",
  "private": true,
  "description": "A configuration-first content intelligence and static publishing engine.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Publume/core.git"
  },
  "homepage": "https://github.com/Publume/core#readme",
  "bugs": {
    "url": "https://github.com/Publume/core/issues"
  },
  "keywords": [
    "ai",
    "content-pipeline",
    "github-actions",
    "publishing",
    "static-site"
  ],
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": ">=1.3.0"
  },
  "scripts": {
    "run": "bun src/cli.ts",
    "initial": "bun src/cli.ts --initial",
    "bootstrap": "bun src/cli.ts --bootstrap",
    "build": "bun run typecheck",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "quality": "biome check .",
    "test": "bun test",
    "acceptance": "bun run scripts/acceptance.ts",
    "eval:prompt": "bun run scripts/prompt-eval.ts",
    "eval:profiles": "bun run scripts/profile-prompt-eval.ts",
    "check": "bun run quality && bun run typecheck && bun test && bun run acceptance"
  },
  "dependencies": {
    "@mozilla/readability": "0.6.0",
    "cheerio": "^1.1.2",
    "jsdom": "26.1.0",
    "rss-parser": "^3.13.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "@types/bun": "latest",
    "@types/jsdom": "30.0.0",
    "@types/node": "^26.2.0",
    "@types/xml2js": "^0.4.14",
    "typescript": "^7.0.2"
  }
}
